<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Supabase sync, storage uploads and the Edge Functions behind the AI features. Odo
         works fully offline, so nothing here is required for the app to start. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Read before a sync pass, so an offline device queues work instead of retrying. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The scanner: bills, documents and payment QR codes all start as a camera frame.
         Requested at runtime the first time the owner opens the scanner, never at launch. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Declared not-required so a device without a camera can still install Odo. Everything
         except scanning works without one, and the scanner reports the camera as unavailable
         rather than the app being missing from the store. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <!-- Trip tracking: GPS fixes while a trip is in progress, including while the app is
         backgrounded (the owner is driving, not looking at the phone). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- ActivityRecognition Transition API: IN_VEHICLE/STILL/WALKING transitions gate when
         GPS is worth turning on. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- Bluetooth ACL connect/disconnect broadcasts from the bonded vehicle device. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- The trip-tracking foreground service and its location subtype (Android 14+ requires
         the subtype permission alongside the base one). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- The persistent trip-tracking notification, required at runtime on Android 13+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android 11 hides installed apps from each other unless they are declared here. Without
         this, asking whether anything can take a UPI payment always answers "nothing", and the
         scan-to-pay flow would report no UPI app on a phone that has four. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="upi" />
        </intent>
    </queries>

    <application
        android:name=".OdoApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:exported="true"
            android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>