<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Supabase sync, storage uploads and the Edge Functions behind the AI features. Odo
         works fully offline, so nothing here is required for the app to start. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Read before a sync pass, so an offline device queues work instead of retrying. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The scanner: bills, documents and payment QR codes all start as a camera frame.
         Requested at runtime the first time the owner opens the scanner, never at launch. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Declared not-required so a device without a camera can still install Odo. Everything
         except scanning works without one, and the scanner reports the camera as unavailable
         rather than the app being missing from the store. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <!-- Document expiry reminders, required at runtime on Android 13+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Auto odometer is off for 1.0 (FeatureFlags.AUTO_ODOMETER_ENABLED), so the app asks
         for none of what it needs: ACCESS_FINE_LOCATION, ACCESS_COARSE_LOCATION,
         ACCESS_BACKGROUND_LOCATION, ACTIVITY_RECOGNITION, BLUETOOTH_CONNECT,
         FOREGROUND_SERVICE and FOREGROUND_SERVICE_LOCATION were all removed here. Put them
         back alongside :core:triptracker's own manifest when the flag goes true. -->

    <!-- Pay via QR is off for 1.0 (FeatureFlags.PAY_VIA_QR_ENABLED), so the <queries> block
         that declared the `upi:` VIEW intent was removed from here. It is Android 11+ package
         visibility rather than a permission, but it exists only so the scan-to-pay flow can
         ask "can anything on this phone take a payment" — and a manifest that still asks is a
         manifest that still describes a feature the app does not ship.

         Put it back with the flag. Without it `resolveActivity` answers null on a phone with
         four UPI apps installed, so the flow would report "no UPI app" for everyone:

             <queries>
                 <intent>
                     <action android:name="android.intent.action.VIEW" />
                     <data android:scheme="upi" />
                 </intent>
             </queries> -->

    <application
        android:name=".OdoApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:exported="true"
            android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>