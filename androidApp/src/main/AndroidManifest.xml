<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Supabase sync, storage uploads and the Edge Functions behind the AI features. Odo
         works fully offline, so nothing here is required for the app to start. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Read before a sync pass, so an offline device queues work instead of retrying. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The scanner: bills, documents and payment QR codes all start as a camera frame.
         Requested at runtime the first time the owner opens the scanner, never at launch. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Declared not-required so a device without a camera can still install Odo. Everything
         except scanning works without one, and the scanner reports the camera as unavailable
         rather than the app being missing from the store. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <!-- Trip tracking: GPS fixes while a trip is in progress, including while the app is
         backgrounded (the owner is driving, not looking at the phone). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- ActivityRecognition Transition API: IN_VEHICLE/STILL/WALKING transitions gate when
         GPS is worth turning on. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- Bluetooth ACL connect/disconnect broadcasts from the bonded vehicle device. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- The trip-tracking foreground service and its location subtype (Android 14+ requires
         the subtype permission alongside the base one). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- The persistent trip-tracking notification, required at runtime on Android 13+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Firebase Analytics brings these three in transitively and nothing here asks for them:
         AD_ID from play-services-measurement-impl, the two ADSERVICES ones from
         play-services-measurement-api. Odo shows no ads and runs no ad campaigns, so an app
         that declares them is an app whose Data safety form has to answer "yes, we collect
         the Advertising ID" — which is the opposite of what the privacy policy says.

         Removing the permission stops Play seeing the declaration. It does not stop the SDK
         reading the ID on a device where some other app holds the permission, so the two
         meta-data flags in <application> below turn the collection itself off. Both halves
         are needed; neither is enough alone.

         The cost is Google Ads attribution and Google Signals (age, gender, interests in the
         Analytics console). Events, funnels, audiences and every Crashlytics and Performance
         feature keep working — they run on the App Instance ID, not the Advertising ID. Put
         all five lines back if Odo ever runs a paid campaign, and update the Data safety form
         and the privacy policy in the same change. -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION"
        tools:node="remove" />

    <!-- Android 11 hides installed apps from each other unless they are declared here. Without
         this, asking whether anything can take a UPI payment always answers "nothing", and the
         scan-to-pay flow reports no UPI app on a phone that has four. It did exactly that.

         **Name the authority.** A <queries> declaration is matched against the other app's
         intent filter by the same rules as an intent, and a filter that names an authority
         only matches a query that names one too. Google Pay declares `upi` with
         `Authority: "pay"`, so a scheme-only entry never saw it — nor PhonePe, Paytm or BHIM,
         which all declare the same shape. The reverse is not a problem: an entry that names an
         authority still matches a filter that declares none, since a filter without one
         accepts any. So one entry per scheme, always with the authority, is both necessary
         and sufficient. Verified on device, both directions.

         The three after `upi` are the payment apps' own schemes. They are here because an app
         keeps its `upi:` activity disabled until UPI is set up inside it, and on such a phone
         only its own scheme answers. Why that fallback exists at all is written up in
         UpiDeepLink.candidates; this list must stay in step with the one there.

         Note there is no QUERY_ALL_PACKAGES. These narrow entries do the same job, need no
         Play declaration form, and cannot be used to inventory the phone. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data
                android:host="pay"
                android:scheme="upi" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data
                android:host="upi"
                android:scheme="tez" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data
                android:host="pay"
                android:scheme="phonepe" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data
                android:host="pay"
                android:scheme="paytmmp" />
        </intent>
    </queries>

    <application
        android:name=".OdoApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- The runtime half of the AD_ID removal above. The first flag stops Analytics
             reading the Advertising ID at all; the second stops it marking the events it does
             send as usable for ad personalisation. Read by the Firebase SDK at startup, so
             they apply to the automatic events the SDK collects on its own, not only to the
             ones Odo logs through HAnalytics. -->
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_personalization_signals"
            android:value="false" />

        <activity
            android:exported="true"
            android:name=".MainActivity"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>