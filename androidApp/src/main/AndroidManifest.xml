<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Supabase sync, storage uploads and the Edge Functions behind the AI features. Odo
         works fully offline, so nothing here is required for the app to start. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Read before a sync pass, so an offline device queues work instead of retrying. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The scanner: bills, documents and payment QR codes all start as a camera frame.
         Requested at runtime the first time the owner opens the scanner, never at launch. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Declared not-required so a device without a camera can still install Odo. Everything
         except scanning works without one, and the scanner reports the camera as unavailable
         rather than the app being missing from the store. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <!-- Document expiry reminders, required at runtime on Android 13+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Auto odometer is off for 1.0 (FeatureFlags.AUTO_ODOMETER_ENABLED), so the app asks
         for none of what it needs: ACCESS_FINE_LOCATION, ACCESS_COARSE_LOCATION,
         ACCESS_BACKGROUND_LOCATION, ACTIVITY_RECOGNITION, BLUETOOTH_CONNECT,
         FOREGROUND_SERVICE and FOREGROUND_SERVICE_LOCATION were all removed here. Put them
         back alongside :core:triptracker's own manifest when the flag goes true. -->

    <!-- Smart refuel's payment-notification detection has no permission line of its own: a
         notification listener is granted by the owner enabling Odo in the system's
         notification-access list, not by a runtime prompt. What makes it possible at all is
         the <service> declared inside <application> below, next to MainActivity. Removing
         that declaration is what turns the feature off at the platform level rather than in
         code — see FeatureFlags.SMART_REFUEL_DETECT_ENABLED. -->

    <!-- Firebase Analytics brings these three in transitively and nothing here asks for them:
         AD_ID from play-services-measurement-impl, the two ADSERVICES ones from
         play-services-measurement-api. Odo shows no ads and runs no ad campaigns, so an app
         that declares them is an app whose Data safety form has to answer "yes, we collect
         the Advertising ID" — which is the opposite of what the privacy policy says.

         Removing the permission stops Play seeing the declaration. It does not stop the SDK
         reading the ID on a device where some other app holds the permission, so the two
         meta-data flags in <application> below turn the collection itself off. Both halves
         are needed; neither is enough alone.

         The cost is Google Ads attribution and Google Signals (age, gender, interests in the
         Analytics console). Events, funnels, audiences and every Crashlytics and Performance
         feature keep working — they run on the App Instance ID, not the Advertising ID. Put
         all five lines back if Odo ever runs a paid campaign, and update the Data safety form
         and the privacy policy in the same change. -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION"
        tools:node="remove" />

    <application
        android:name=".OdoApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- The runtime half of the AD_ID removal above. The first flag stops Analytics
             reading the Advertising ID at all; the second stops it marking the events it does
             send as usable for ad personalisation. Read by the Firebase SDK at startup, so
             they apply to the automatic events the SDK collects on its own, not only to the
             ones Odo logs through HAnalytics. -->
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_personalization_signals"
            android:value="false" />

        <!-- singleTop so a widget tap on an already-running app is delivered to
             onNewIntent rather than starting a second copy of the activity. Without it the
             owner taps "Scan pump", the existing screen stays where it was, and nothing
             appears to happen. -->
        <activity
            android:exported="true"
            android:launchMode="singleTop"
            android:name=".MainActivity"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Smart refuel's payment-notification listener, gated by
             FeatureFlags.SMART_REFUEL_DETECT_ENABLED. This declaration is the one site a
             project-wide Kotlin search for that flag will not find.

             The OS binds this only after the owner enables Odo in Settings → Notification
             access; there is no runtime prompt, which is why the app's own opt-in screen has
             to explain what will be read before sending them there. The service filters to
             the packages the owner enabled before it looks at any text, and forwards only a
             merchant name, a sum and a timestamp — nothing is stored and nothing is sent.

             Expect a listing review to ask about this. Deleting this block is how the feature
             is switched off at the platform level. -->
        <service
            android:name="com.hopcape.odo.core.platform.notification.RefuelNotificationListenerService"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- The home-screen widget: scan a pump, type a fill, or update the odometer.
             Not exported — the launcher binds it through the AppWidget framework, and
             nothing else has any reason to. -->
        <receiver
            android:name=".widget.RefuelWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/refuel_widget_info" />
        </receiver>

        <!-- Lets another app read a file Odo exports — today, the service record PDF the
             share sheet sends. Odo's files live in private storage, so a receiving app
             cannot open a path; this hands it a content:// URI instead, readable only for
             as long as the activity the owner picked is running.

             The authority carries ${applicationId}, so debug, stage and release each get
             their own. Two installed variants claiming one authority is an install failure.

             file_paths.xml exposes the exports directory and nothing else. Every scanned
             bill and uploaded policy sits under the same filesDir, and a provider pointed
             at the root would make all of them readable by whatever the owner shares to. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>