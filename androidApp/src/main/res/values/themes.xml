<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- The theme the window keeps once the splash hands over. Its background is the
         first screen's bg token, so the handover to the Compose surface shows no flash.
         The bar values match enableEdgeToEdge(): the splash library copies them onto the
         window when its exit animation starts. -->
    <style name="Theme.Odo" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/odo_splash_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/odo_light_system_bars</item>
    </style>

    <!-- The launch theme, played as the Ignition Sweep. It stays on screen until
         MainActivity says the startup gate has resolved (#473). -->
    <style name="Theme.Odo.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/odo_splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/avd_splash_ignition</item>
        <!-- Required on API 31-32 for the icon to animate; ignored from API 33. -->
        <item name="windowSplashScreenAnimationDuration">1680</item>
        <item name="postSplashScreenTheme">@style/Theme.Odo</item>
    </style>

</resources>
