<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Stands in for a UPI app, so the scan-to-pay flow has something to resolve against.

             Before handing over a payment link, Odo asks the package manager whether anything
             can pay it, and answers "no UPI app on this phone" when nothing can. An emulator
             has none, so without this the flow could only ever be tested down its failure
             path. Espresso answers the intent before this activity is ever started — it exists
             to be found, not to run.

             What this stub does NOT do is test package visibility, though it claimed to. A
             test APK instruments the app it targets, and the platform makes an instrumented
             pair visible to each other automatically — `dumpsys package queries` lists this
             activity under "queries via package name", never as an intent match. So the app's
             <queries> element is not what finds it here, and dropping that element entirely
             leaves these tests green. That is how the scan-to-pay flow came to answer "no UPI
             app on this phone" on every real device while this suite stayed green. Only a
             separately installed app can exercise it.

             The filter still names `host="pay"`, because every real UPI app does and a stub
             worth having looks like one. It is documentation, not coverage. -->
        <activity
            android:name="android.app.Activity"
            android:exported="true"
            android:label="Test UPI app">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />

                <data
                    android:host="pay"
                    android:scheme="upi" />
            </intent-filter>
        </activity>
    </application>

</manifest>
