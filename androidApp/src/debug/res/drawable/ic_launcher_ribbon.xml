<?xml version="1.0" encoding="utf-8"?>
<!-- The debug build's ribbon: a red diagonal band across the top-right corner,
     reading DEBUG.

     Drawn in the adaptive icon's 108x108 space. Everything sits inside one group
     rotated 45 degrees about the icon centre, so the band and its letters are authored
     horizontally and land on the diagonal together. Rotating clockwise puts a band that
     was above the centre into the top-right corner, and turns left-to-right text into
     text that reads down-and-right along the band — the direction a corner ribbon wants.

     Placement is set by the adaptive icon's masks, not by taste. A launcher may clip the
     foreground to a circle of radius 36 about the centre (54,54), and a true corner
     ribbon — one that actually touches the corner — sits at a distance of about 39 and
     would be cut away entirely on every round-icon launcher. So the band is pulled in to
     a distance of 26, where the circle still leaves roughly 50 units of it showing. It
     reads as a corner ribbon while surviving circle, squircle, rounded-square and
     teardrop masks alike.

     The letters are stroked paths, not text: VectorDrawable has no text support, so each
     glyph is drawn as geometry in its own 6.5x9 group and translated into place. This is
     why the word cannot simply be re-typed — editing it means redrawing letters. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="45">

        <!-- The band. Spans the full width before rotation so both ends run past the
             mask and no launcher reveals a cut-off end. -->
        <path
            android:fillColor="#D32F2F"
            android:pathData="M0,19h108v18h-108z" />

        <!-- A darker edge on each side, so the band still separates from the icon
             where the mark behind it is light. -->
        <path
            android:fillColor="#8E1F1F"
            android:pathData="M0,19h108v1.5h-108zM0,35.5h108v1.5h-108z" />

        <!-- DEBUG, centred on the band: five 6.5-wide glyph boxes with 3 between them
             is 44.5 across, so the run starts at x=32 to sit centred on x=54. Each
             glyph is drawn in a local 0..6.5 by 0..9 frame; the vertical translate of
             23.5 centres the 9-tall boxes on the band's midline at y=28. -->
        <group android:translateX="32" android:translateY="23.5">
            <path
                android:strokeColor="#FFFFFF"
                android:strokeWidth="1.5"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:pathData="M0.9,0.9 L0.9,8.1 M0.9,0.9 L3,0.9 C4.9,0.9 5.6,2.5 5.6,4.5 C5.6,6.5 4.9,8.1 3,8.1 L0.9,8.1" />
        </group>

        <group android:translateX="41.5" android:translateY="23.5">
            <path
                android:strokeColor="#FFFFFF"
                android:strokeWidth="1.5"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:pathData="M5.6,0.9 L0.9,0.9 L0.9,8.1 L5.6,8.1 M0.9,4.5 L4.7,4.5" />
        </group>

        <group android:translateX="51" android:translateY="23.5">
            <path
                android:strokeColor="#FFFFFF"
                android:strokeWidth="1.5"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:pathData="M0.9,0.9 L0.9,8.1 M0.9,0.9 L3.4,0.9 C5.2,0.9 5.2,4.5 3.4,4.5 L0.9,4.5 M0.9,4.5 L3.6,4.5 C5.4,4.5 5.4,8.1 3.6,8.1 L0.9,8.1" />
        </group>

        <group android:translateX="60.5" android:translateY="23.5">
            <path
                android:strokeColor="#FFFFFF"
                android:strokeWidth="1.5"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:pathData="M0.9,0.9 L0.9,5.6 C0.9,7.3 2,8.1 3.25,8.1 C4.5,8.1 5.6,7.3 5.6,5.6 L5.6,0.9" />
        </group>

        <group android:translateX="70" android:translateY="23.5">
            <path
                android:strokeColor="#FFFFFF"
                android:strokeWidth="1.5"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:pathData="M5.6,2.4 C4.9,1.2 4.1,0.9 3.2,0.9 C1.8,0.9 0.9,2.4 0.9,4.5 C0.9,6.6 1.8,8.1 3.2,8.1 C4.6,8.1 5.6,7.2 5.6,5.9 L5.6,5.2 L3.6,5.2" />
        </group>
    </group>
</vector>
