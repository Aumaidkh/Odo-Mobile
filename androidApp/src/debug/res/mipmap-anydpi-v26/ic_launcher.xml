<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only override of the adaptive launcher icon. Same background and mark as
     production; the foreground is the ribboned layer list.

     minSdk is 26, so every device Odo runs on resolves the icon here rather than from
     the mipmap-*dpi PNGs — overriding this one file is enough, and the PNGs are left
     alone. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground_debug" />
</adaptive-icon>
