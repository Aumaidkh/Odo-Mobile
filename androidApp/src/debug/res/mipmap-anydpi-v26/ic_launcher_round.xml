<?xml version="1.0" encoding="utf-8"?>
<!-- The round variant, ribboned the same way. Launchers that ask for the round icon
     get one that still says debug; without this file they would fall back to the
     production mark. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground_debug" />
</adaptive-icon>
