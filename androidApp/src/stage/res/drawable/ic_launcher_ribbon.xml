<?xml version="1.0" encoding="utf-8"?>
<!-- The stage build's ribbon: an amber diagonal band across the top-right corner,
     reading STAGE. The debug build carries the same ribbon in red — see
     src/debug/res/drawable/ic_launcher_ribbon.xml, which documents the geometry in
     full. Only the colours and the five glyphs differ.

     The letters are dark, not white as on the red debug ribbon. White on amber is
     about 2:1 contrast, which stops being readable at launcher size; dark ink on
     amber is roughly 8:1 and is the pairing warning tape has used forever.

     Geometry, in short: one group rotated 45 degrees about the icon centre, so the
     band and its letters are authored horizontally and land on the diagonal together.
     The band sits 26 units from the centre rather than at the true corner, because a
     round-icon launcher clips the foreground to a radius of 36 and a corner ribbon
     would be cut away entirely.

     The letters are stroked paths, not text: VectorDrawable has no text support, so
     each glyph is drawn as geometry in its own 6.5x9 group and translated into place.
     STAGE and DEBUG are both five letters, so the glyph boxes land on the same
     positions in both files. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="45">

        <!-- The band. Spans the full width before rotation so both ends run past the
             mask and no launcher reveals a cut-off end. -->
        <path
            android:fillColor="#FFA000"
            android:pathData="M0,19h108v18h-108z" />

        <!-- A darker edge on each side, so the band still separates from the icon
             where the mark behind it is light. -->
        <path
            android:fillColor="#B26F00"
            android:pathData="M0,19h108v1.5h-108zM0,35.5h108v1.5h-108z" />

        <!-- STAGE, centred on the band: five 6.5-wide glyph boxes with 3 between them
             is 44.5 across, so the run starts at x=32 to sit centred on x=54. Each
             glyph is drawn in a local 0..6.5 by 0..9 frame; the vertical translate of
             23.5 centres the 9-tall boxes on the band's midline at y=28. -->
        <group android:translateX="32" android:translateY="23.5">
            <path
                android:strokeColor="#3B2400"
                android:strokeWidth="1.5"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:pathData="M5.6,2.2 C5,1.2 4.1,0.9 3.2,0.9 C1.9,0.9 0.9,1.7 0.9,2.9 C0.9,5.6 5.6,4.2 5.6,6.3 C5.6,7.5 4.5,8.1 3.2,8.1 C2.2,8.1 1.4,7.7 0.9,6.8" />
        </group>

        <group android:translateX="41.5" android:translateY="23.5">
            <path
                android:strokeColor="#3B2400"
                android:strokeWidth="1.5"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:pathData="M0.9,0.9 L5.6,0.9 M3.25,0.9 L3.25,8.1" />
        </group>

        <group android:translateX="51" android:translateY="23.5">
            <path
                android:strokeColor="#3B2400"
                android:strokeWidth="1.5"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:pathData="M0.9,8.1 L3.25,0.9 L5.6,8.1 M1.7,5.7 L4.8,5.7" />
        </group>

        <group android:translateX="60.5" android:translateY="23.5">
            <path
                android:strokeColor="#3B2400"
                android:strokeWidth="1.5"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:pathData="M5.6,2.4 C4.9,1.2 4.1,0.9 3.2,0.9 C1.8,0.9 0.9,2.4 0.9,4.5 C0.9,6.6 1.8,8.1 3.2,8.1 C4.6,8.1 5.6,7.2 5.6,5.9 L5.6,5.2 L3.6,5.2" />
        </group>

        <group android:translateX="70" android:translateY="23.5">
            <path
                android:strokeColor="#3B2400"
                android:strokeWidth="1.5"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:pathData="M5.6,0.9 L0.9,0.9 L0.9,8.1 L5.6,8.1 M0.9,4.5 L4.7,4.5" />
        </group>
    </group>
</vector>
