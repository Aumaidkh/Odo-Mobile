# Template only — real values go in .env (gitignored). Never commit real keys here.

# ---- AI (Gemini free tier — key: https://aistudio.google.com/apikey) ----
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ---- Telegram approval bot (create via @BotFather) ----
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
# Owner chat id (message @userinfobot to get it)
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID_HERE
# Any random string; same value goes in setWebhook secret_token
TELEGRAM_WEBHOOK_SECRET=YOUR_RANDOM_WEBHOOK_SECRET_HERE

# ---- Instagram Graph API (Meta developer app, Instagram Login flow) ----
IG_USER_ID=YOUR_INSTAGRAM_BUSINESS_USER_ID_HERE
# Initial long-lived token (~60 days). After first run it lives in social.app_config
# and is auto-refreshed by the refresh-ig-token function.
IG_ACCESS_TOKEN=YOUR_LONG_LIVED_IG_TOKEN_HERE

# ---- Supabase (renderer / GitHub Actions secrets) ----
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE
