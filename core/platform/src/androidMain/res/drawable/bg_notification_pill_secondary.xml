<?xml version="1.0" encoding="utf-8"?>
<!--
    The outlined pill behind "Edit".

    Outline rather than a fill, so the two buttons say which one is the expected answer without
    either of them shouting. The stroke is translucent and flips with the shade's mode, like
    every other colour on this notification.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="1dp"
        android:color="@color/refuel_notification_outline" />
    <corners android:radius="999dp" />
</shape>
