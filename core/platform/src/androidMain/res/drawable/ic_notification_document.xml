        android:pathData="M13.5,3H6.5A1.5,1.5 0,0 0,5 4.5v15A1.5,1.5 0,0 0,6.5 21h11A1.5,1.5 0,0 0,19 19.5V8.5zM13.5,3v5.5H19"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M8.5,12.5h7M8.5,16h4.5"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
