<!--
    The document-reminder notification's small icon — a sheet of paper with two text lines.

    Drawn as strokes, not as a filled sheet with a cut-out corner: a small icon keeps only its
    alpha channel and is re-tinted by the system, so a "white sheet with a black fold" would
    come out as one solid blob. Strokes keep the shape readable at 24dp.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
