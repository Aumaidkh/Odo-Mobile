<?xml version="1.0" encoding="utf-8"?>
<!--
    The detected-fill notification's small icon — a fuel pump.

    Drawn as strokes, like the document icon and for the same reason: a small icon keeps only
    its alpha channel and is re-tinted by the system, so anything drawn as a filled body with
    darker detail inside comes back as one solid blob. Strokes keep the pump readable at 24dp.

    The nozzle arm on the right is what makes it read as a pump rather than a fridge at this
    size, so it stays even though it costs the shape some clear space.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- The pump body and its base line. -->
    <path
        android:pathData="M4,20V5.5A1.5,1.5 0,0 1,5.5 4h6A1.5,1.5 0,0 1,13 5.5V20M3,20.5h11"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
    <!-- The reading window. -->
    <path
        android:pathData="M6.5,7.5h4v3.5h-4z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.6"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
    <!-- The hose arm, and the tank it feeds. -->
    <path
        android:pathData="M13,9.5h2.5A1.5,1.5 0,0 1,17 11v6a1.5,1.5 0,0 0,3 0v-6l-2.5,-3.5"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
</vector>
