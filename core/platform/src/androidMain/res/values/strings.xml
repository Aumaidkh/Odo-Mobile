<?xml version="1.0" encoding="utf-8"?>
<!--
    Text the system draws, so it lives in Android resources rather than in the Compose
    multiplatform resources the screens use. A notification is built by the OS from a
    Context, which cannot reach those.
-->
<resources>
    <string name="document_reminder_channel_name">Document reminders</string>
    <string name="document_reminder_channel_description">Insurance, PUC and licence renewals before they lapse</string>

    <string name="document_reminder_title_days">%1$s expires in %2$d days</string>
    <string name="document_reminder_title_tomorrow">%1$s expires tomorrow</string>
    <string name="document_reminder_body">Renew it before %1$s to stay covered.</string>

    <string name="custom_reminder_channel_name">Your reminders</string>
    <string name="custom_reminder_channel_description">The reminders you set yourself</string>
    <string name="custom_reminder_body">Tap to open Odo.</string>

    <!-- The document vault's own labels, repeated for the notification. -->
    <string name="document_kind_insurance">Insurance</string>
    <string name="document_kind_puc">PUC certificate</string>
    <string name="document_kind_rc">RC</string>
    <string name="document_kind_licence">Driving licence</string>
    <string name="document_kind_loan">Loan papers</string>
    <string name="document_kind_other">Document</string>
    <string name="refuel_detected_channel_name">Detected fuel fills</string>
    <string name="refuel_detected_channel_description">A payment at a fuel station, ready to log in one tap</string>

    <!-- Nudges: Odo's own idea, on their own channel. An owner who mutes being nudged must
         not lose a PUC expiry with it. -->
    <string name="nudge_channel_name">Nudges from Odo</string>
    <string name="nudge_channel_description">Occasional suggestions — never a deadline</string>
    <string name="nudge_first_score_title">Your car\'s first health score is ready</string>
    <string name="nudge_first_score_body">It is modelled for now. Scan one bill and it becomes your car\'s own.</string>
    <string name="nudge_scan_follow_up_title">Got another bill lying around?</string>
    <string name="nudge_scan_follow_up_body">Every bill you scan tightens what your car is worth, and catches what you were overcharged.</string>
</resources>
