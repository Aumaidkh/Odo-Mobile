-- Local health-score snapshots — the offline-first mirror of DB_SCHEMA §9.9. Timestamps
-- are ISO-8601 TEXT, which sorts chronologically as text, so `computed_at` can be both
-- the ordering and the cut-off in a WHERE clause.
--
-- Append-only. A snapshot records what was true at a moment, so there is no update
-- statement and no soft delete here; `deleted_at` exists only because the sync engine
-- (SYNC_DESIGN §4.1) expects the full column set on every syncable table, and a column
-- retrofitted later is a migration nobody needs to write.
--
-- The four component columns ARE the breakdown, so there is no `breakdown` jsonb like the
-- server's: a factor is a kind and its earned points, and the kinds are fixed by the PRD.
-- A fifth factor would be a schema change either way.
--
-- `algo_version` is what keeps the history honest. Scores are only comparable within one
-- version of the rules — see HealthScoreCalculator.RULES_VERSION.
--
-- Nothing writes today's score here for display. The score is computed on read; this
-- table exists so "up 6 points this month" has a number from a month ago to subtract.
CREATE TABLE health_scores (
    id                  TEXT NOT NULL PRIMARY KEY,
    car_id              TEXT NOT NULL,
    owner_id            TEXT NOT NULL,
    score               INTEGER NOT NULL,
    maintenance_pts     INTEGER NOT NULL,
    documentation_pts   INTEGER NOT NULL,
    cost_efficiency_pts INTEGER NOT NULL,
    history_pts         INTEGER NOT NULL,
    algo_version        TEXT NOT NULL,
    computed_at         TEXT NOT NULL,
    created_at          TEXT NOT NULL,
    updated_at          TEXT NOT NULL,
    deleted_at          TEXT,
    remote_version      TEXT,
    sync_status         TEXT NOT NULL DEFAULT 'PENDING'
);

-- Both reads are "this car's newest snapshot, optionally before a date", which is exactly
-- what this index answers.
CREATE INDEX idx_health_scores_car_time ON health_scores (car_id, computed_at DESC);

insertSnapshot:
INSERT INTO health_scores (
    id, car_id, owner_id, score,
    maintenance_pts, documentation_pts, cost_efficiency_pts, history_pts,
    algo_version, computed_at, created_at, updated_at, sync_status
)
VALUES (
    :id, :carId, :ownerId, :score,
    :maintenancePts, :documentationPts, :costEfficiencyPts, :historyPts,
    :algoVersion, :computedAt, :now, :now, :syncStatus
);

-- What the score is compared against before a new snapshot is written.
selectLatest:
SELECT *
FROM health_scores
WHERE car_id = :carId AND deleted_at IS NULL
ORDER BY computed_at DESC
LIMIT 1;

-- The timeline's source: every score this car has ever been given, oldest first, because a
-- score event is the move between one snapshot and the next. The same index answers it —
-- read backwards, which SQLite does without a sort.
selectHistory:
SELECT *
FROM health_scores
WHERE car_id = :carId AND deleted_at IS NULL
ORDER BY computed_at ASC;

-- The month delta's baseline: the newest score that is already at least as old as the
-- window the screen is quoting.
selectLatestOnOrBefore:
SELECT *
FROM health_scores
WHERE car_id = :carId AND deleted_at IS NULL AND computed_at <= :instant
ORDER BY computed_at DESC
LIMIT 1;

-- ─────────────────────────────────────────────────────────────────────────────
-- Sync (SYNC_DESIGN §6). These four are the outbox and the delta-pull's writes.
-- They deliberately ignore `deleted_at`: a tombstone is a row the server still
-- has to hear about, and one the server sends so other devices hear about it.
-- ─────────────────────────────────────────────────────────────────────────────

-- The outbox: everything the server has not accepted yet, oldest change first so a
-- partial push still leaves the table in a sensible order.
selectPending:
SELECT *
FROM health_scores
WHERE sync_status = 'PENDING'
ORDER BY updated_at ASC;

-- The two facts the last-write-wins comparison needs. A plain SELECT * would drag the
-- whole row through for a decision that only reads these.
selectSyncState:
SELECT sync_status, updated_at
FROM health_scores
WHERE id = :id;

-- Bookkeeping only. The local row is already the newest version, so nothing but the
-- sync columns changes here (SYNC_DESIGN §6.1).
markSynced:
UPDATE health_scores
SET sync_status = 'SYNCED', remote_version = :remoteVersion
WHERE id = :id;

-- A pulled row, written as SYNCED. Two statements rather than an UPSERT: SQLite 3.18
-- ships with minSdk 26 and has no ON CONFLICT DO UPDATE. The caller runs them inside
-- the pull's transaction.
insertFromRemote:
INSERT OR IGNORE INTO health_scores (id, car_id, owner_id, score, maintenance_pts, documentation_pts, cost_efficiency_pts, history_pts, algo_version, computed_at, created_at, updated_at, deleted_at, remote_version, sync_status)
VALUES (:id, :car_id, :owner_id, :score, :maintenance_pts, :documentation_pts, :cost_efficiency_pts, :history_pts, :algo_version, :computed_at, :created_at, :updated_at, :deleted_at, :remote_version, 'SYNCED');

updateFromRemote:
UPDATE health_scores
SET car_id = :car_id,
    owner_id = :owner_id,
    score = :score,
    maintenance_pts = :maintenance_pts,
    documentation_pts = :documentation_pts,
    cost_efficiency_pts = :cost_efficiency_pts,
    history_pts = :history_pts,
    algo_version = :algo_version,
    computed_at = :computed_at,
    created_at = :created_at,
    updated_at = :updated_at,
    deleted_at = :deleted_at,
    remote_version = :remote_version, sync_status = 'SYNCED'
WHERE id = :id;

-- How much is still waiting to reach the server. Drives the "not backed up yet" chip.
countPending:
SELECT COUNT(*)
FROM health_scores
WHERE sync_status = 'PENDING';

-- Sign-in adoption (SYNC_DESIGN §9): move rows created before there was an account onto
-- the account that just signed in, and put them in the outbox. Matching on the placeholder
-- is what makes this idempotent — a second run finds nothing.
adoptOwnership:
UPDATE health_scores
SET owner_id = :realOwnerId, sync_status = 'PENDING', updated_at = :now
WHERE owner_id = :placeholderOwnerId;
