-- Local service logs — the offline-first source of truth, mirroring DB_SCHEMA §9.4
-- (Postgres types mapped to SQLite). Dates and timestamps are ISO-8601 TEXT;
-- money is integer paise, never a float.
--
-- Sync columns are the mandatory set from SYNC_DESIGN §4.1. Three columns are
-- local-only extensions the server schema does not have yet and that DB_SCHEMA
-- still needs written up:
--   * bill_photo_path   — the M1 manual bill attachment. A `bills` row is M2's
--                         shape and carries scanner-only fields (extraction_json,
--                         confidence, is_handwritten), so a manual photo does not
--                         belong there.
--   * fairness_snapshot — the verdict frozen when it was taken, as JSON. Stored
--                         rather than recomputed so the figure the owner was shown
--                         cannot drift as the city pool moves (DB_SCHEMA §5.5 makes
--                         the same call for bill_line_items).
--   * categories        — see service_log_categories below.
CREATE TABLE service_logs (
    id                 TEXT NOT NULL PRIMARY KEY,
    car_id             TEXT NOT NULL,
    owner_id           TEXT NOT NULL,
    service_date       TEXT NOT NULL,
    odometer_km        INTEGER NOT NULL CHECK (odometer_km >= 0),
    total_amount_paise INTEGER NOT NULL DEFAULT 0 CHECK (total_amount_paise >= 0),
    workshop_name      TEXT,
    notes              TEXT,
    source             TEXT NOT NULL DEFAULT 'MANUAL',
    bill_id            TEXT,
    bill_photo_path    TEXT,
    fairness_snapshot  TEXT,
    created_at         TEXT NOT NULL,
    updated_at         TEXT NOT NULL,
    deleted_at         TEXT,
    remote_version     TEXT,
    sync_status        TEXT NOT NULL DEFAULT 'PENDING'
);

-- The list's query shape: a car's live logs, newest service first.
CREATE INDEX idx_service_logs_car_date
    ON service_logs (car_id, service_date DESC) WHERE deleted_at IS NULL;

CREATE INDEX idx_service_logs_owner
    ON service_logs (owner_id) WHERE deleted_at IS NULL;

-- The "what was done" tags. A junction rather than a column because the domain's
-- `categories` is a Set and the form offers multi-select chips.
--
-- Deliberately WITHOUT the sync column set: these rows are a projection of their
-- parent, not a syncable table of their own. They have no independent identity or
-- lifecycle, so they get no `SyncEntity` slot and no cursor — they travel inside
-- the parent's payload and are rewritten wholesale when it syncs. The consequence
-- that matters: a category-only edit must still dirty the parent row, which the
-- repository guarantees by always writing the parent in the same transaction.
CREATE TABLE service_log_categories (
    service_log_id TEXT NOT NULL,
    category       TEXT NOT NULL,
    PRIMARY KEY (service_log_id, category)
);

-- Rows come back with their categories already gathered into one comma-separated
-- column, so a twenty-entry list is one query rather than one-plus-twenty. Category
-- names are enum constants (OIL_CHANGE, …) so a comma can never appear inside one.
--
-- COALESCE to '' is load-bearing, not tidiness: GROUP_CONCAT over no rows yields NULL,
-- but SQLDelight types the aggregate as non-null, so an untagged entry would throw while
-- being read — and an untagged entry is the *common* case for a manually logged service.
-- Empty string maps to an empty set; the row still comes back.
selectByCar:
SELECT sl.*,
       COALESCE((SELECT GROUP_CONCAT(c.category)
                 FROM service_log_categories c
                 WHERE c.service_log_id = sl.id), '') AS categories
FROM service_logs sl
WHERE sl.car_id = :carId AND sl.deleted_at IS NULL
ORDER BY sl.service_date DESC, sl.created_at DESC;

selectById:
SELECT sl.*,
       COALESCE((SELECT GROUP_CONCAT(c.category)
                 FROM service_log_categories c
                 WHERE c.service_log_id = sl.id), '') AS categories
FROM service_logs sl
WHERE sl.id = :id AND sl.deleted_at IS NULL;

-- Every known odometer reading for a car: its live logs plus the car's own current
-- reading, dated from when that reading was last written down. The domain's
-- OdometerTimeline needs the whole timeline, not just the highest value, because
-- the ordering rule is date-relative.
--
-- The car's reading falls back to `created_at` — onboarding wrote it, and it has
-- not been updated since. Both columns are full instants while `service_date` is a
-- date, so the baseline is truncated to its date half and the two mean the same
-- thing. An empty result means the car does not exist (a live car always
-- contributes its own reading).
selectOdometerReadings:
SELECT NULL AS log_id,
       substr(COALESCE(c.odometer_updated_at, c.created_at), 1, 10) AS reading_date,
       c.current_odometer_km AS odometer_km
FROM cars c
WHERE c.id = :carId AND c.deleted_at IS NULL
UNION ALL
SELECT sl.id, sl.service_date, sl.odometer_km
FROM service_logs sl
WHERE sl.car_id = :carId AND sl.deleted_at IS NULL;

insertServiceLog:
INSERT INTO service_logs (
    id, car_id, owner_id, service_date, odometer_km, total_amount_paise,
    workshop_name, notes, source, bill_id, bill_photo_path, fairness_snapshot,
    created_at, updated_at, deleted_at, remote_version, sync_status
) VALUES (
    :id, :carId, :ownerId, :serviceDate, :odometerKm, :totalAmountPaise,
    :workshopName, :notes, :source, :billId, :billPhotoPath, :fairnessSnapshot,
    :now, :now, NULL, NULL, :syncStatus
);

-- `car_id`, `owner_id`, `created_at` and `remote_version` are absent on purpose:
-- an entry does not change car or owner by being edited, the first write owns the
-- creation time, and the last sync owns the remote version. `sync_status` returns
-- to PENDING because an edited row has to reach the server again.
updateServiceLog:
UPDATE service_logs
SET service_date       = :serviceDate,
    odometer_km        = :odometerKm,
    total_amount_paise = :totalAmountPaise,
    workshop_name      = :workshopName,
    notes              = :notes,
    source             = :source,
    bill_id            = :billId,
    bill_photo_path    = :billPhotoPath,
    fairness_snapshot  = :fairnessSnapshot,
    updated_at         = :updatedAt,
    sync_status        = :syncStatus
WHERE id = :id AND deleted_at IS NULL;

-- Soft delete: the row stays as a tombstone so the deletion itself can sync and
-- history/audit survives. It goes back to PENDING for exactly that reason.
softDeleteServiceLog:
UPDATE service_logs
SET deleted_at  = :deletedAt,
    updated_at  = :deletedAt,
    sync_status = :syncStatus
WHERE id = :id AND deleted_at IS NULL;

-- Every live entry of one car, tombstoned together. Used when the car itself is
-- removed: an entry is only reachable through its car, so it goes with it.
--
-- The category rows are left alone. They hang off the entry, not the car, and the
-- entry is still there as a tombstone that has to sync with its categories intact.
softDeleteServiceLogsForCar:
UPDATE service_logs
SET deleted_at  = :deletedAt,
    updated_at  = :deletedAt,
    sync_status = :syncStatus
WHERE car_id = :carId AND deleted_at IS NULL;

insertCategory:
INSERT OR IGNORE INTO service_log_categories (service_log_id, category)
VALUES (:serviceLogId, :category);

deleteCategoriesFor:
DELETE FROM service_log_categories WHERE service_log_id = :serviceLogId;
