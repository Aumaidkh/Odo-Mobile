-- Local cars table — the offline-first source of truth, mirroring
-- DB_SCHEMA §9.3 (Postgres types mapped to SQLite). Integers come back as Long
-- and 0/1 booleans; the data-layer mappers convert to/from the domain Car.
--
-- `remote_version` and `sync_status` (PENDING|SYNCED|CONFLICT) are the
-- client-only sync columns from SYNC_DESIGN §4.1 — groundwork for the engine
-- that lands in M5. They are not part of the authoritative server schema and
-- are never surfaced to the domain.
CREATE TABLE cars (
    id                  TEXT NOT NULL PRIMARY KEY,
    owner_id            TEXT NOT NULL,
    make                TEXT NOT NULL,
    model               TEXT NOT NULL,
    variant             TEXT,
    year                INTEGER NOT NULL CHECK (year BETWEEN 1980 AND 2100),
    fuel_type           TEXT NOT NULL,
    registration_number TEXT,
    current_odometer_km INTEGER NOT NULL CHECK (current_odometer_km >= 0),
    purchase_year       INTEGER CHECK (purchase_year BETWEEN 1980 AND 2100),
    nickname            TEXT,
    is_primary          INTEGER NOT NULL DEFAULT 0,
    created_at          TEXT NOT NULL,
    updated_at          TEXT NOT NULL,
    deleted_at          TEXT,
    remote_version      TEXT,
    sync_status         TEXT NOT NULL DEFAULT 'PENDING'
);

-- Owner lookups skip soft-deleted rows.
CREATE INDEX idx_cars_owner ON cars (owner_id) WHERE deleted_at IS NULL;

-- At most one live primary car per owner (matches the DB partial unique index).
CREATE UNIQUE INDEX uq_cars_one_primary
    ON cars (owner_id) WHERE is_primary = 1 AND deleted_at IS NULL;

-- No two live cars share a registration number per owner.
CREATE UNIQUE INDEX uq_cars_owner_reg
    ON cars (owner_id, registration_number)
    WHERE registration_number IS NOT NULL AND deleted_at IS NULL;

insertCar:
INSERT INTO cars (
    id, owner_id, make, model, variant, year, fuel_type, registration_number,
    current_odometer_km, purchase_year, nickname, is_primary,
    created_at, updated_at, deleted_at, remote_version, sync_status
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Edit a stored car. Onboarding saves the car when its step completes (so the
-- first-scan step has a real car to hand the scanner), which makes stepping back
-- to fix a detail an update rather than a second insert.
--
-- `owner_id` and `created_at` are absent on purpose: ownership doesn't change by
-- editing, and the creation time is the first write's to keep. `sync_status`
-- returns to PENDING because an edited row has to reach the server again.
updateCar:
UPDATE cars
SET make                = :make,
    model               = :model,
    variant             = :variant,
    year                = :year,
    fuel_type           = :fuelType,
    registration_number = :registrationNumber,
    current_odometer_km = :odometerKm,
    purchase_year       = :purchaseYear,
    nickname            = :nickname,
    is_primary          = :isPrimary,
    updated_at          = :updatedAt,
    sync_status         = :syncStatus
WHERE id = :id AND deleted_at IS NULL;

-- Demote any current primary for the owner (used before inserting a new primary
-- so the one-primary invariant holds locally even without the DB constraint).
clearPrimaryForOwner:
UPDATE cars
SET is_primary = 0, updated_at = :updatedAt
WHERE owner_id = :ownerId AND is_primary = 1 AND deleted_at IS NULL;

selectPrimaryCar:
SELECT *
FROM cars
WHERE is_primary = 1 AND deleted_at IS NULL
LIMIT 1;

selectById:
SELECT *
FROM cars
WHERE id = ? AND deleted_at IS NULL;
