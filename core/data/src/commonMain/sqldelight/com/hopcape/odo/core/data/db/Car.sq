-- Local cars table — the offline-first source of truth, mirroring
-- DB_SCHEMA §9.3 (Postgres types mapped to SQLite). Integers come back as Long
-- and 0/1 booleans; the data-layer mappers convert to/from the domain Car.
--
-- `remote_version` and `sync_status` (PENDING|SYNCED|CONFLICT) are the
-- client-only sync columns from SYNC_DESIGN §4.1 — groundwork for the engine
-- that lands in M5. They are not part of the authoritative server schema and
-- are never surfaced to the domain.
CREATE TABLE cars (
    id                  TEXT NOT NULL PRIMARY KEY,
    owner_id            TEXT NOT NULL,
    make                TEXT NOT NULL,
    model               TEXT NOT NULL,
    variant             TEXT,
    year                INTEGER NOT NULL CHECK (year BETWEEN 1980 AND 2100),
    fuel_type           TEXT NOT NULL,
    registration_number TEXT,
    current_odometer_km INTEGER NOT NULL CHECK (current_odometer_km >= 0),
    purchase_year       INTEGER CHECK (purchase_year BETWEEN 1980 AND 2100),
    nickname            TEXT,
    is_primary          INTEGER NOT NULL DEFAULT 0,
    -- When `current_odometer_km` was last written down. A reading means nothing
    -- without the day it was taken: the odometer timeline reads the car's current
    -- reading as a dated entry, and without this it would be dated from when the
    -- car was added — which would reject every backdated service log after the
    -- first odometer update. Client-only, like the sync columns.
    odometer_updated_at TEXT,
    created_at          TEXT NOT NULL,
    updated_at          TEXT NOT NULL,
    deleted_at          TEXT,
    remote_version      TEXT,
    sync_status         TEXT NOT NULL DEFAULT 'PENDING'
);

-- Owner lookups skip soft-deleted rows.
CREATE INDEX idx_cars_owner ON cars (owner_id) WHERE deleted_at IS NULL;

-- At most one live primary car per owner (matches the DB partial unique index).
CREATE UNIQUE INDEX uq_cars_one_primary
    ON cars (owner_id) WHERE is_primary = 1 AND deleted_at IS NULL;

-- No two live cars share a registration number per owner.
CREATE UNIQUE INDEX uq_cars_owner_reg
    ON cars (owner_id, registration_number)
    WHERE registration_number IS NOT NULL AND deleted_at IS NULL;

insertCar:
INSERT INTO cars (
    id, owner_id, make, model, variant, year, fuel_type, registration_number,
    current_odometer_km, purchase_year, nickname, is_primary,
    odometer_updated_at, created_at, updated_at, deleted_at, remote_version, sync_status
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Edit a stored car. Onboarding saves the car when its step completes (so the
-- first-scan step has a real car to hand the scanner), which makes stepping back
-- to fix a detail an update rather than a second insert.
--
-- `owner_id` and `created_at` are absent on purpose: ownership doesn't change by
-- editing, and the creation time is the first write's to keep. `sync_status`
-- returns to PENDING because an edited row has to reach the server again.
--
-- `odometer_updated_at` is passed in rather than always set to now, because most
-- edits (a nickname, a corrected trim) don't touch the reading, and re-dating it
-- would claim the odometer was checked when it wasn't. The caller passes the
-- stored value back when the reading is unchanged.
updateCar:
UPDATE cars
SET make                = :make,
    model               = :model,
    variant             = :variant,
    year                = :year,
    fuel_type           = :fuelType,
    registration_number = :registrationNumber,
    current_odometer_km = :odometerKm,
    purchase_year       = :purchaseYear,
    nickname            = :nickname,
    is_primary          = :isPrimary,
    odometer_updated_at = :odometerUpdatedAt,
    updated_at          = :updatedAt,
    sync_status         = :syncStatus
WHERE id = :id AND deleted_at IS NULL;

-- Demote any current primary for the owner (used before inserting a new primary
-- so the one-primary invariant holds locally even without the DB constraint).
clearPrimaryForOwner:
UPDATE cars
SET is_primary = 0, updated_at = :updatedAt
WHERE owner_id = :ownerId AND is_primary = 1 AND deleted_at IS NULL;

selectPrimaryCar:
SELECT *
FROM cars
WHERE is_primary = 1 AND deleted_at IS NULL
LIMIT 1;

selectById:
SELECT *
FROM cars
WHERE id = ? AND deleted_at IS NULL;

-- Soft delete: the row stays as a tombstone so the deletion itself can sync and
-- history/audit survives. It goes back to PENDING for exactly that reason.
--
-- `is_primary` is left as it was. The one-primary index already ignores deleted
-- rows, so the flag blocks nothing, and clearing it would be a local-only edit
-- the server never asked for.
softDeleteCar:
UPDATE cars
SET deleted_at  = :deletedAt,
    updated_at  = :deletedAt,
    sync_status = :syncStatus
WHERE id = :id AND deleted_at IS NULL;

-- ─────────────────────────────────────────────────────────────────────────────
-- Sync (SYNC_DESIGN §6). These four are the outbox and the delta-pull's writes.
-- They deliberately ignore `deleted_at`: a tombstone is a row the server still
-- has to hear about, and one the server sends so other devices hear about it.
-- ─────────────────────────────────────────────────────────────────────────────

-- The outbox: everything the server has not accepted yet, oldest change first so a
-- partial push still leaves the table in a sensible order.
selectPending:
SELECT *
FROM cars
WHERE sync_status = 'PENDING'
ORDER BY updated_at ASC;

-- The two facts the last-write-wins comparison needs. A plain SELECT * would drag the
-- whole row through for a decision that only reads these.
selectSyncState:
SELECT sync_status, updated_at
FROM cars
WHERE id = :id;

-- Bookkeeping only. The local row is already the newest version, so nothing but the
-- sync columns changes here (SYNC_DESIGN §6.1).
markSynced:
UPDATE cars
SET sync_status = 'SYNCED', remote_version = :remoteVersion
WHERE id = :id;

-- A pulled row, written as SYNCED. Two statements rather than an UPSERT: SQLite 3.18
-- ships with minSdk 26 and has no ON CONFLICT DO UPDATE. The caller runs them inside
-- the pull's transaction.
insertFromRemote:
INSERT OR IGNORE INTO cars (id, owner_id, make, model, variant, year, fuel_type, registration_number, current_odometer_km, purchase_year, nickname, is_primary, odometer_updated_at, created_at, updated_at, deleted_at, remote_version, sync_status)
VALUES (:id, :owner_id, :make, :model, :variant, :year, :fuel_type, :registration_number, :current_odometer_km, :purchase_year, :nickname, :is_primary, :odometer_updated_at, :created_at, :updated_at, :deleted_at, :remote_version, 'SYNCED');

updateFromRemote:
UPDATE cars
SET owner_id = :owner_id,
    make = :make,
    model = :model,
    variant = :variant,
    year = :year,
    fuel_type = :fuel_type,
    registration_number = :registration_number,
    current_odometer_km = :current_odometer_km,
    purchase_year = :purchase_year,
    nickname = :nickname,
    is_primary = :is_primary,
    odometer_updated_at = :odometer_updated_at,
    created_at = :created_at,
    updated_at = :updated_at,
    deleted_at = :deleted_at,
    remote_version = :remote_version, sync_status = 'SYNCED'
WHERE id = :id;

-- How much is still waiting to reach the server. Drives the "not backed up yet" chip.
countPending:
SELECT COUNT(*)
FROM cars
WHERE sync_status = 'PENDING';

-- Sign-in adoption (SYNC_DESIGN §9): move rows created before there was an account onto
-- the account that just signed in, and put them in the outbox. Matching on the placeholder
-- is what makes this idempotent — a second run finds nothing.
adoptOwnership:
UPDATE cars
SET owner_id = :realOwnerId, sync_status = 'PENDING', updated_at = :now
WHERE owner_id = :placeholderOwnerId;

-- Sign-out wipe. **Hard** delete, deliberately not the soft delete used everywhere else: a
-- soft delete sets `deleted_at` and leaves the row PENDING, so the next sign-in would push
-- tombstones and destroy the owner's data on the server. Signing out must never be able to
-- delete a backup.
deleteAllRows:
DELETE FROM cars;
