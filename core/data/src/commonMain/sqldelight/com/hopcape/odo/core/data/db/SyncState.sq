-- Where each entity's sync got to. One row per SyncEntity, keyed on its enum name.
--
-- A SQLDelight table rather than DataStore, and that is the whole reason it exists here:
-- the cursor has to move in the *same transaction* as the rows it describes. A pull that
-- writes twenty rows and then dies before saving the cursor would re-apply those rows next
-- run — harmless — but a cursor saved before the rows would skip them forever. DataStore
-- cannot join a SQLDelight transaction, so it cannot give that guarantee.
--
-- `last_pulled_at` is the server's `updated_at` high-water mark, not a local clock reading.
-- It is compared against server timestamps, so a device with a skewed clock must never be
-- the one writing it.
--
-- `last_pushed_at` and `last_error` are diagnostics only — nothing branches on them. They
-- back the debug row in Profile, which is the first thing anyone asks for when a user says
-- their data is missing.
--
-- No sync columns of its own: this table describes syncing, it is not synced. It is local
-- to the install, like `app_settings`.
--
-- Design: docs/SYNC_DESIGN.md §4.2.
CREATE TABLE sync_state (
    entity         TEXT NOT NULL PRIMARY KEY,
    last_pulled_at TEXT,
    last_pushed_at TEXT,
    last_error     TEXT
);

selectByEntity:
SELECT *
FROM sync_state
WHERE entity = :entity;

-- Every entity's state at once — the debug row reads this.
selectAll:
SELECT *
FROM sync_state
ORDER BY entity;

-- The newest successful pull across every entity. Null until one has succeeded, which is
-- what `lastSyncedAt` reports on a fresh install.
selectNewestPull:
SELECT MAX(last_pulled_at)
FROM sync_state;

-- Insert-or-update in two statements, wrapped in a transaction by the caller. SQLite 3.18
-- ships with minSdk 26 and has no UPSERT, so `INSERT OR IGNORE` then `UPDATE` is the
-- portable form.
insertIgnore:
INSERT OR IGNORE INTO sync_state (entity)
VALUES (:entity);

update:
UPDATE sync_state
SET last_pulled_at = :lastPulledAt,
    last_pushed_at = :lastPushedAt,
    last_error     = :lastError
WHERE entity = :entity;

-- Used by the tests and by account deletion; a cleared cursor makes the next run a full
-- re-pull, which is always safe because applying a row is idempotent.
deleteAll:
DELETE FROM sync_state;

-- How much of the owner's data has not reached the server yet, across every syncable table.
-- One query rather than six, because it backs a Flow that re-runs on any of them changing.
countAllPending:
SELECT
    (SELECT COUNT(*) FROM profiles           WHERE sync_status = 'PENDING') +
    (SELECT COUNT(*) FROM cars               WHERE sync_status = 'PENDING') +
    (SELECT COUNT(*) FROM service_logs       WHERE sync_status = 'PENDING') +
    (SELECT COUNT(*) FROM overcharge_reports WHERE sync_status = 'PENDING') +
    (SELECT COUNT(*) FROM documents          WHERE sync_status = 'PENDING') +
    (SELECT COUNT(*) FROM health_scores      WHERE sync_status = 'PENDING') AS pending;
