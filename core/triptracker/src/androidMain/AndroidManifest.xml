<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      This module's first library-owned manifest (no other module here has one — every
      other Android adapter in this repo registers its receiver dynamically at runtime,
      e.g. core:platform's AndroidSmsCodeReader). That pattern doesn't fit here: a
      dynamically-registered receiver only exists while some component in the process is
      alive to have registered it, but ACTION_ACL_CONNECTED/DISCONNECTED and the
      ActivityRecognition Transition API are both on Android's implicit-broadcast
      exemption list specifically so a car connecting can start tracking even after the
      process was killed. Only a manifest-declared receiver survives that.

      Everything below is live only while auto odometer is on
      (FeatureFlags.AUTO_ODOMETER_ENABLED). It has to be emptied together with the app
      manifest's location, activity-recognition, Bluetooth and foreground-service
      permissions if the flag ever goes false again — a service typed "location" is a
      lint error without FOREGROUND_SERVICE_LOCATION.
    -->

    <application>
        <service
            android:name=".service.TripTrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <receiver
            android:name=".motion.ActivityTransitionReceiver"
            android:exported="false" />

        <!--
          ACL_CONNECTED/DISCONNECTED are protected broadcasts (only the Bluetooth stack can
          send them — enforced by the platform, not by a permission declared here) and are
          on the Android 8+ implicit-broadcast exemption list, so a manifest receiver still
          gets them. exported="true" because the sender is a different, system process.
        -->
        <receiver
            android:name=".bluetooth.BluetoothAclReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
