<?xml version="1.0" encoding="utf-8"?>
<!--
    The trip-tracking notification's small icon — a speedometer glyph (ring, needle,
    centre hub), ported from :core:designsystem's IcSpeedometer so the notification reads
    as the same mark, not a generic system icon.

    A notification's small icon is drawn as a silhouette: Android extracts only the alpha
    channel and re-tints every pixel with the notification's accent colour, so the fill/
    stroke colours here are never seen as-is — only the shape matters.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="16"
    android:viewportHeight="16">
    <path
        android:pathData="M2,8a6,6 0,1 1,12 0a6,6 0,1 1,-12 0M8,8L11.2,5.4"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M6.9,8a1.1,1.1 0,1 1,2.2 0a1.1,1.1 0,1 1,-2.2 0"
        android:fillColor="#FFFFFF" />
</vector>
