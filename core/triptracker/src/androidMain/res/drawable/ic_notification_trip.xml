<?xml version="1.0" encoding="utf-8"?>
<!--
    The trip-tracking notification's small icon — Odo's own gauge mark, the same arc that
    ic_launcher_foreground draws, so a glance at the status bar says "Odo" rather than
    "some app is using your location".

    A notification's small icon is drawn as a silhouette: Android keeps only the alpha
    channel and re-tints every pixel with the notification's accent colour, so the stroke
    colour here is never seen. That is also why this is one arc rather than the launcher's
    two — the launcher layers a lighter arc behind a darker one, and in a silhouette the
    two merge into a single blob with no gap left to read.

    Kept at the launcher's 512 viewport so the path is the mark verbatim, with the group
    scaled to leave the breathing room a 24dp status-bar icon needs.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="512"
    android:viewportHeight="512">
    <group
        android:pivotX="256"
        android:pivotY="256"
        android:scaleX="0.92"
        android:scaleY="0.92">
        <path
            android:pathData="M153.314,395.47C133.914,378.144 119.201,356.201 110.541,331.675C101.88,307.149 99.5511,280.833 103.77,255.167C107.989,229.501 118.62,205.316 134.676,184.853C150.733,164.39 171.695,148.311 195.621,138.108C219.547,127.905 245.661,123.907 271.543,126.485C297.426,129.063 322.238,138.134 343.681,152.856C365.124,167.578 382.503,187.476 394.208,210.704C405.912,233.932 411.563,259.74 410.636,285.734"
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="57"
            android:strokeLineCap="round" />
    </group>
</vector>
