<?xml version="1.0" encoding="utf-8"?>
<!--
  The Android-native local defaults resource — Firebase's own documented convention for
  "what a fresh install answers before its first network fetch" (loaded via the real SDK's
  FirebaseRemoteConfig.setDefaultsAsync(int), see LocalRemoteConfigDefaults.android.kt).

  Kept in sync by hand with RemoteConfigAppStatusSource's key/value contract
  (docs/APP_STATUS_PLAN.md §3), RemoteConfigLegalLinks's, RemoteConfigSupportContacts's, and
  with the REMOTE_DEFAULTS maps those three declare — the Kotlin copies used on every other platform. Change one, change both.
-->
<defaultsMap>
    <entry>
        <key>min_supported_version_code</key>
        <value>0</value>
    </entry>
    <entry>
        <key>maintenance_mode</key>
        <value>off</value>
    </entry>
    <entry>
        <key>maintenance_message</key>
        <value></value>
    </entry>

    <!--
      The published legal pages (docs/PRIVACY_PERMISSIONS_PLAN.md). Set these in the Firebase
      console to repoint the in-app links — a move to a custom domain, or a correction to a
      URL that turns out to be wrong, then needs no release.

      Empty here on purpose, and NOT a placeholder to fill in. Empty means "no override", and
      RemoteConfigLegalLinks then uses the address the build derives from its own Supabase
      project. Putting a URL here would freeze one project's address into every build.
    -->
    <entry>
        <key>legal_privacy_policy_url</key>
        <value></value>
    </entry>
    <entry>
        <key>legal_terms_url</key>
        <value></value>
    </entry>
    <entry>
        <key>legal_delete_account_url</key>
        <value></value>
    </entry>

    <!--
      Where "Email us" and the three feedback forms send their mail. Set this in the Firebase
      console to move support to another mailbox without a release.

      Empty here on purpose, and NOT an address to fill in. Empty means "no override", and
      RemoteConfigSupportContacts then uses the address compiled into the build. Putting one
      here would freeze it into every build twice over.
    -->
    <entry>
        <key>support_email</key>
        <value></value>
    </entry>
</defaultsMap>
