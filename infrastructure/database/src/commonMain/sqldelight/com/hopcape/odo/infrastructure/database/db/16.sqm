-- Bills already checked and paid for.
--
-- The result screen re-reads on every visit, so without this a second look at the same bill
-- charged a second check and filed its prices into the shared pool a second time. One is the
-- owner's money; the other skews the band every other owner is shown.
CREATE TABLE checked_bills (
    service_log_id TEXT NOT NULL PRIMARY KEY,
    checked_at     TEXT NOT NULL
);
