-- The ideas people have already asked for, as the panel curates them.
--
-- Pull-only. The count and the status are the server's to decide — a count assembled from one
-- device is not a count — and the only thing this device puts back is its own vote, which is
-- its own table.
--
-- No owner_id: the catalogue is the same list for everybody, so a sign-out wipe leaves it
-- alone and the next owner does not re-fetch what is already here.
CREATE TABLE feature_ideas (
    id          TEXT NOT NULL PRIMARY KEY,
    title       TEXT NOT NULL,
    status      TEXT NOT NULL,
    votes       INTEGER NOT NULL DEFAULT 0,
    created_at  TEXT NOT NULL,
    updated_at  TEXT NOT NULL,
    deleted_at  TEXT
);

-- The list as the screen draws it: this owner's vote joined onto the shared catalogue, most
-- wanted first. LEFT JOIN, because an idea nobody on this device has voted for is still an
-- idea — an inner join would show only what they had already voted on.
selectWithVotes:
SELECT
    i.id,
    i.title,
    i.status,
    i.votes,
    -- The vote table's key is the pair, so its own idea_id is what says a row matched.
    v.idea_id IS NOT NULL AND v.deleted_at IS NULL AS voted
FROM feature_ideas i
LEFT JOIN idea_votes v ON v.idea_id = i.id AND v.owner_id = :ownerId
WHERE i.deleted_at IS NULL
ORDER BY i.votes DESC, i.title ASC;

upsertFromRemote:
INSERT OR REPLACE INTO feature_ideas (id, title, status, votes, created_at, updated_at, deleted_at)
VALUES (:id, :title, :status, :votes, :createdAt, :updatedAt, :deletedAt);

deleteAllRows:
DELETE FROM feature_ideas;
