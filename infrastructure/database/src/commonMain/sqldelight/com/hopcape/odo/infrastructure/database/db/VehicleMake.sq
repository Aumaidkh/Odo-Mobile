-- Seeded reference table backing the make dropdown. Populated idempotently from
-- the data layer (INSERT OR IGNORE) so the brand list lives in the DB, not in
-- Presentation.
CREATE TABLE vehicle_make (
    id            TEXT NOT NULL PRIMARY KEY,
    name          TEXT NOT NULL UNIQUE,
    display_order INTEGER NOT NULL,
    -- A Storage path such as `vehicle-logos/makes/make-kia.png`; null shows the monogram.
    logo_path     TEXT
);

insertMake:
INSERT OR IGNORE INTO vehicle_make (id, name, display_order, logo_path)
VALUES (?, ?, ?, ?);

selectMakeLogos:
SELECT name, logo_path
FROM vehicle_make
WHERE logo_path IS NOT NULL;

selectAllMakes:
SELECT name
FROM vehicle_make
ORDER BY display_order, name;

-- The one-tap brand chips. Deliberately the same ordering as selectAllMakes with
-- a limit, rather than a separate `is_popular` column: the seed is already in
-- market-share order, so "popular" and "listed first" are the same fact and can
-- never drift apart.
selectPopularMakes:
SELECT name
FROM vehicle_make
ORDER BY display_order, name
LIMIT :limit;

countMakes:
SELECT count(*) FROM vehicle_make;

-- Used only by a full reseed (bootstrap version bump or a remote refresh) — both replace the
-- whole reference table rather than patch it, because these rows have no owner-entered data
-- that a delete could lose (`cars.make` is a plain string, not a reference to this table).
deleteAllMakes:
DELETE FROM vehicle_make;
