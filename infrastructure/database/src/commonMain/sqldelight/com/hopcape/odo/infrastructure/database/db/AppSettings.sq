-- Device settings — theme, text size, the units figures are shown in, and which
-- notifications the owner agreed to.
--
-- **Deliberately not a syncable table.** It mirrors nothing on the server: there
-- is no `app_settings` in DB_SCHEMA, and there should not be. A theme belongs to
-- the phone it is read on, not to the account, so the mandatory sync column set
-- (SYNC_DESIGN §4.1) is absent here on purpose rather than by oversight. If the
-- notification topics ever have to follow an owner between devices they move
-- onto `profiles`, which already syncs.
--
-- One row, pinned to id 1. A key-value shape would store the same seven flags
-- with no type checking and a join for every read; the columns are the schema.
--
-- tracker_enabled: whether automatic trip tracking is on (docs/TRIPTRACKER_PLAN.md).
-- Device-local for the same reason as every other column here — it names a
-- foreground-service/permission state specific to this phone, not the account.
CREATE TABLE app_settings (
    id                   INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
    theme                TEXT NOT NULL,
    larger_text          INTEGER NOT NULL,
    distance_unit        TEXT NOT NULL,
    fuel_efficiency_unit TEXT NOT NULL,
    notif_doc_expiry     INTEGER NOT NULL,
    notif_service_due    INTEGER NOT NULL,
    notif_custom         INTEGER NOT NULL,
    notif_overcharge     INTEGER NOT NULL,
    notif_monthly        INTEGER NOT NULL,
    notif_health_drop    INTEGER NOT NULL,
    notif_partner        INTEGER NOT NULL,
    notif_push           INTEGER NOT NULL,
    notif_whatsapp       INTEGER NOT NULL,
    tracker_enabled      INTEGER NOT NULL DEFAULT 0,
    updated_at           TEXT NOT NULL
);

-- Insert-then-update in one transaction, not an UPSERT: `ON CONFLICT ... DO
-- UPDATE` needs SQLite 3.24 and minSdk 26 ships 3.18.
insertSettings:
INSERT OR IGNORE INTO app_settings (
    id, theme, larger_text, distance_unit, fuel_efficiency_unit,
    notif_doc_expiry, notif_service_due, notif_custom, notif_overcharge,
    notif_monthly, notif_health_drop, notif_partner, notif_push, notif_whatsapp,
    tracker_enabled, updated_at
) VALUES (
    1, :theme, :largerText, :distanceUnit, :fuelEfficiencyUnit,
    :notifDocExpiry, :notifServiceDue, :notifCustom, :notifOvercharge,
    :notifMonthly, :notifHealthDrop, :notifPartner, :notifPush, :notifWhatsapp,
    :trackerEnabled, :updatedAt
);

updateSettings:
UPDATE app_settings
SET theme                = :theme,
    larger_text          = :largerText,
    distance_unit        = :distanceUnit,
    fuel_efficiency_unit = :fuelEfficiencyUnit,
    notif_doc_expiry     = :notifDocExpiry,
    notif_service_due    = :notifServiceDue,
    notif_custom         = :notifCustom,
    notif_overcharge     = :notifOvercharge,
    notif_monthly        = :notifMonthly,
    notif_health_drop    = :notifHealthDrop,
    notif_partner        = :notifPartner,
    notif_push           = :notifPush,
    notif_whatsapp       = :notifWhatsapp,
    tracker_enabled      = :trackerEnabled,
    updated_at           = :updatedAt
WHERE id = 1;

selectSettings:
SELECT *
FROM app_settings
WHERE id = 1;
