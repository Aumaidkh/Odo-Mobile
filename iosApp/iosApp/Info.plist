<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- Shown in the system camera prompt. iOS asks once and never again, so this string is
	     the only explanation some owners will read. -->
	<key>NSCameraUsageDescription</key>
	<string>Odo uses the camera to read your service bills, your insurance and PUC papers, and payment QR codes. Photos are taken only when you tap Scan.</string>
</dict>
</plist>
