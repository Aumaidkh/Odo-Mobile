TEAM_ID=

PRODUCT_NAME=Odo
PRODUCT_BUNDLE_IDENTIFIER=com.hopcape.odo.Odo$(TEAM_ID)

// Keep these in step with `odo-versionCode` / `odo-versionName` in
// gradle/libs.versions.toml by hand — Xcode cannot read the Gradle version catalog,
// and this is the only place the iOS build gets its version from.
//
// MARKETING_VERSION drops the pre-release qualifier the Android versionName carries
// ("1.0.0-beta01"): App Store Connect rejects a CFBundleShortVersionString that is not
// a plain dotted number. TestFlight tells builds apart by CURRENT_PROJECT_VERSION.
CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0.0

// The shared framework is static and pulls in SQLDelight's native SQLite driver
// (co.touchlab:sqliter), whose cinterop references sqlite3_* symbols. A static
// framework doesn't bundle them, so the app must link the system libsqlite3.
OTHER_LDFLAGS=$(inherited) -lsqlite3