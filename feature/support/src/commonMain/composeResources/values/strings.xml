    <!-- ===================== Feedback forms ===================== -->
    <!-- Report a problem, Suggest an idea and Flag wrong price data are the same screen with
         different words. Titles are reused from the help sheet rows (sp_report, sp_idea,
         sp_flag) so a row and the screen it opens can never drift apart.

         The button does not say "Send": Odo does not send anything. It opens the owner\'s own
         mail app on a draft, and they send it. Saying otherwise would be a lie the first time
         somebody backs out of the composer and assumes it went. -->
    <string name="sp_fb_hint">Your message</string>
    <string name="sp_fb_send">Continue in email</string>
    <!-- Stated on the form, not just in the draft: somebody deciding whether to write at all
         should know what rides along before they start typing. -->
    <string name="sp_fb_attach_note">Your app version and phone model are added to the email so we can work out what went wrong. Nothing is sent until you send it, and you can edit or delete any of it first.</string>
    <!-- The attach-diagnostics choice, on the problem report only. An idea or a wrong price
         has no logs worth reading, and a checkbox there would be noise asking for data
         nobody would open. Default on: a problem report without logs is the one support has
         to answer with "can you send us diagnostics", which costs the owner another round
         trip. -->
    <string name="sp_fb_attach_diagnostics">Attach diagnostics</string>
    <string name="sp_fb_attach_diagnostics_sub">Recent app logs — what the app did and any errors. No bills, documents, photos or trip locations.</string>
    <!-- Added to the draft under the footer when diagnostics are attached. %1$s is the
         reference code the logs upload under. -->
    <string name="sp_fb_diagnostics_line">Diagnostics: %1$s</string>

    <string name="sp_fb_report_intro">Tell us what happened. Fill in what you can — anything you leave blank is fine.</string>
    <string name="sp_fb_report_subject">Problem report</string>
    <!-- The form opens on this rather than an empty box. Headings, not questions, so the
         owner types under them instead of reading a paragraph and starting from nothing.
         Trailing newlines are deliberate: the cursor lands where they should write. -->
    <string name="sp_fb_report_body">What went wrong:\n\n\nWhat I was doing at the time:\n\n\nWhat I expected instead:\n</string>

    <string name="sp_fb_idea_intro">Tell us what you would like Odo to do. Fill in what you can — anything you leave blank is fine.</string>
    <string name="sp_fb_idea_subject">Feature idea</string>
    <string name="sp_fb_idea_body">What I would like Odo to do:\n\n\nWhen I would use it:\n\n\nWhat I do today instead:\n</string>

    <string name="sp_fb_flag_intro">Tell us which job looked wrong. Fill in what you can — anything you leave blank is fine.</string>
    <string name="sp_fb_flag_subject">Wrong price data</string>
    <!-- City is asked for because benchmarks are worked out per city, so a report without
         one cannot be checked against anything. -->
    <string name="sp_fb_flag_body">The job or part:\n\n\nWhat Odo showed:\n\n\nWhat I actually paid:\n\n\nMy city:\n</string>

    <!-- Appended below the owner\'s message in the draft. %1$s is the version name, %2$s the
         build number, %3$s the manufacturer, %4$s the model, %5$s the OS and its version. -->
    <string name="sp_fb_mail_footer">---\nSent from Odo v%1$s (build %2$s)\n%3$s %4$s · %5$s</string>
    <!-- ===================== Licences ===================== -->
    <!-- Library and licence names are not here on purpose: they live in LicenceCatalog.kt.
         A licence is identified by its exact name, and translating "Apache License 2.0"
         would name a document that does not exist. Only the words around them are copy. -->
    <string name="sp_lic_intro">Odo is built on open source. These are the libraries it ships with, and the licences they are used under.</string>
    <!-- %1$s is the licence name, e.g. "Read the full Apache License 2.0". -->
    <string name="sp_lic_read">Read the full %1$s</string>
    <!-- ===================== Rate Odo ===================== -->
    <!-- Deliberately NOT a review gate. Whatever the rating, both the Play Store and the
         "tell us privately" path are offered — a low rating leads with the message box, but
         the store link is never withheld. Sending unhappy owners away from the listing while
         steering happy ones to it is what Play policy calls discouraging negative reviews,
         and Apple bars it outright. -->
    <string name="sp_rate_title">How is Odo working for you?</string>
    <string name="sp_rate_subtitle">Tap a star. It takes a second and it tells us a lot.</string>
    <!-- One label per star, so the row can be operated and not merely read. %1$d is that
         star's position. -->
    <string name="sp_rate_star_cd">Rate %1$d out of 5</string>

    <string name="sp_rate_prompt_low">Sorry that it is not working out. Telling us what went wrong is the fastest way to get it fixed.</string>
    <string name="sp_rate_prompt_high">Glad to hear it. If anything would make Odo better, we would like to know.</string>

    <string name="sp_rate_body_low">What is not working:\n\n\nWhat would fix it:\n</string>
    <string name="sp_rate_body_high">What works well:\n\n\nWhat would make it better:\n</string>

    <string name="sp_rate_send">Send feedback</string>
    <string name="sp_rate_play">Rate on Play Store</string>
    <!-- %1$d is the star count, so a reply thread is sortable without opening it. -->
    <string name="sp_rate_subject">App rating: %1$d of 5</string>
</resources>
