    <!-- Footer. %1$s is the version name, %2$s the build number, e.g.
         "Odo v1.0.0-beta01 (build 1)".
         The build number is shown on every build type here, unlike the profile footer: this
         line is the one a support ticket quotes, and the version alone does not identify a
         build.

         It used to say "tap to copy diagnostics" and was tappable, which was wrong twice:
         nothing was copied — the tap uploaded logs to the server — and a hidden tap on a
         12sp caption is the gesture Android uses for developer menus, not a way to offer
         something to an owner. Sending diagnostics is a row of its own now. -->
    <string name="sp_version">Odo v%1$s (build %2$s)</string>

    <!-- ===================== Send diagnostics ===================== -->
    <!-- Deliberately demoted. Logs with no ticket attached are an orphan upload: nobody knows
         what problem they were sent for. The path that matters is "Report a problem", which
         attaches them to a message. This row exists because "please send us diagnostics" is
         the most common thing a support agent says, and the owner needs something to tap when
         they hear it. -->
    <string name="sp_diag">Send diagnostics</string>
    <string name="sp_diag_sub">Only if support asked you to</string>
    <string name="sp_diag_confirm_title">Send diagnostics?</string>
    <!-- Says what leaves the phone and what does not. The second half is the load-bearing
         one: somebody agreeing to send "logs" has no way to know whether that includes their
         bills and papers, and it never does. -->
    <string name="sp_diag_confirm_body">This sends recent app logs — what the app did, when, and any errors. Your bills, documents, photos and trip locations are not included.</string>
    <!-- "Send", not "Send diagnostics": the dialog title already names what this is,
         and a button repeating the row it came from reads as the row itself. -->
    <string name="sp_diag_confirm_send">Send</string>
    <string name="sp_diag_cancel">Cancel</string>
    <string name="sp_diag_sent_title">Diagnostics queued</string>
    <!-- %1$s is the reference code. "Queued", not "sent": the upload waits for a network and
         may finish minutes later, and claiming it has arrived would be the same kind of lie
         the old footer told. -->
    <string name="sp_diag_sent_body">Quote this code when you reply to support:\n\n%1$s\n\nThe upload finishes on its own once you have a connection.</string>
    <string name="sp_diag_done">Done</string>

    <!-- ===================== Privacy policy ===================== -->
    <!-- The in-app summary. Deliberately short and native rather than a web view: this has
         to render offline, in the app's own theme, at the owner's text size. The full
         document is one tap away and is the authoritative one.

         Every claim below must match supabase/functions/legal/pages/privacy.ts. Two are
         load-bearing and worth re-checking before each release: bill text is read on the
         device, and trip coordinates never leave the phone. -->
    <string name="sp_pp_title">Privacy policy</string>
    <!-- %1$s is the date the hosted documents last changed, %2$s the app-facing revision. -->
    <string name="sp_pp_revision">Last updated %1$s · %2$s</string>

    <string name="sp_pp_short">The short version</string>
    <string name="sp_pp_lede">Your bills, documents and car records belong to you. We store them so the app works, and we don\'t sell them or hand them to advertisers.</string>

    <string name="sp_pp_collect">WHAT WE COLLECT</string>
    <string name="sp_pp_collect_body">Your mobile number, the car details you enter, and anything you scan or upload — bills, insurance, PUC, RC.</string>

    <string name="sp_pp_why">WHY WE COLLECT IT</string>
    <string name="sp_pp_why_body">To read your bills, check prices against your city, track running costs and remind you before documents expire.</string>

    <string name="sp_pp_share">WHAT WE SHARE</string>
    <string name="sp_pp_share_body">Only anonymised prices, and only if you left that on — never your name, number, workshop or documents.</string>

    <string name="sp_pp_read_full">Read the full policy</string>
    <string name="sp_pp_terms">Terms of use</string>
    <string name="sp_pp_cd_share">Share the privacy policy</string>
    <string name="sp_pp_cd_opens_browser">Opens in your browser</string>

    <!-- ===================== FAQs and search ===================== -->
    <!-- Answers, not marketing. Each one states what the app does today; anything that is
         not built yet is left out rather than promised. Two answers repeat load-bearing
         privacy claims (bill text read on the device, trip points staying on the phone) and
         must keep matching the privacy policy and supabase/functions/legal/pages/privacy.ts.

         Deliberately free of numbers that drift: the free scan allowance and the Pro prices
         are set by the store and change without an app release, so an answer that quoted
         them would go stale on the device. -->
    <string name="sp_faq_title">FAQs</string>
    <string name="sp_faq_expand">Show the answer</string>

    <string name="sp_faq_q_offline">Does Odo work without internet?</string>
    <string name="sp_faq_a_offline">Yes. Everything you enter is saved on the phone first, so logging a service, adding a document or checking your costs all work with no signal. When you are back online it syncs in the background.</string>

    <string name="sp_faq_q_auto_odo">How does Odo update my odometer on its own?</string>
    <string name="sp_faq_a_auto_odo">Once you enrol your car, Odo notices when you start driving and adds the distance to your odometer. It uses your car's Bluetooth stereo, where you have one, to tell your drives apart from other journeys. You can always correct the reading by hand.</string>

    <string name="sp_faq_q_background">Why does Odo ask for location in the background?</string>
    <string name="sp_faq_a_background">Only to measure a drive after the screen goes off. Without it a trip stops being counted the moment you put the phone down. You can skip it and log distance yourself.</string>

    <string name="sp_faq_q_routes">Do my trips leave my phone?</string>
    <string name="sp_faq_a_routes">No. Trip points stay on the device and are never uploaded. Only the distance is used, and you can turn off keeping them at all in Profile, under Privacy.</string>

    <string name="sp_faq_q_scan">How does bill scanning work?</string>
    <string name="sp_faq_a_scan">You photograph the bill and Odo reads the text on the device itself. It fills in the workshop, date, line items and total for you to check before saving.</string>

    <string name="sp_faq_q_fairness">What is my bill compared against?</string>
    <string name="sp_faq_a_fairness">Prices other owners have paid for the same work in your city, anonymised. Nothing that identifies you, your car or your workshop is ever part of it, and you can turn sharing off in Profile, under Privacy.</string>

    <string name="sp_faq_q_no_benchmark">Why does a fairness check say it has no data?</string>
    <string name="sp_faq_a_no_benchmark">A benchmark only appears once enough owners have logged the same job in your city. Until then Odo would rather say nothing than compare your bill against a number it cannot stand behind.</string>

    <string name="sp_faq_q_health">What is the Health Score?</string>
    <string name="sp_faq_a_health">A read on how well the car is being kept, built from what you have actually recorded — services logged, documents that are current, and how complete your history is. It moves as you record more.</string>

    <string name="sp_faq_q_reminders">Will Odo warn me before my insurance or PUC runs out?</string>
    <string name="sp_faq_a_reminders">Yes. Add the document with its expiry date and Odo notifies you ahead of time. How many days' notice you get is yours to set in Profile, under Notifications.</string>

    <string name="sp_faq_q_pro">What does Pro add?</string>
    <string name="sp_faq_a_pro">Unlimited bill scans, an unlimited document vault, the full Health Score breakdown, and your complete record as a printable PDF. Logging services, fills and documents stays free.</string>

    <string name="sp_faq_q_car_count">Can I keep more than one car in Odo?</string>
    <string name="sp_faq_a_car_count">Not yet. Odo holds one car at a time today.</string>

    <string name="sp_faq_q_delete">How do I delete my account and everything in it?</string>
    <string name="sp_faq_a_delete">Profile, then Privacy, then Delete my account and data. It erases your record rather than hiding it, so it cannot be undone.</string>

