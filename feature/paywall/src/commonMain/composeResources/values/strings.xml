    <string name="pw_headline_savings">Catch every overcharge, automatically.</string>
    <string name="pw_subtitle_savings">You found %1$s on one bill. Pro checks every bill you’ll ever pay — and pays for itself fast.</string>

    <!-- Feature list. Four things, and Pro does all four today: nothing here is a promise. -->
    <string name="pw_feature_scans_title">Unlimited bill scans</string>
    <string name="pw_feature_scans_sub">Check every bill for overcharges</string>
    <string name="pw_feature_documents_title">Unlimited document vault</string>
    <string name="pw_feature_documents_sub">Every paper for the car, in one place</string>
    <string name="pw_feature_health_title">Full Health Score breakdown</string>
    <string name="pw_feature_health_sub">See exactly what moves your score</string>
    <string name="pw_feature_export_title">Export your full record</string>
    <string name="pw_feature_export_sub">A printable PDF buyers and workshops trust</string>

    <!-- Plans. Every price comes from the store at run time, so no figure is written here. -->
    <string name="pw_plan_monthly">Monthly</string>
    <string name="pw_plan_monthly_period">per month</string>
    <string name="pw_plan_annual">Annual</string>
    <string name="pw_plan_annual_period">≈ %1$s / mo</string>
    <string name="pw_plan_annual_badge">SAVE %1$d%</string>

    <!-- CTA. The price is the store's own string, so both take it as an argument. -->
    <string name="pw_cta">Start Pro · %1$s</string>
    <string name="pw_cta_trial">Start %1$d-day free trial</string>
    <string name="pw_cta_working">Just a moment…</string>

    <!--
      Play requires the terms before the button, not after it: price, period, that it renews,
      and how long the trial runs. Two versions, because a plan with no trial must not claim
      one.
    -->
    <string name="pw_terms_trial">%1$d days free, then %2$s. Renews automatically until you cancel.</string>
    <string name="pw_terms">%1$s, billed %2$s. Renews automatically until you cancel.</string>
    <!-- A one-off purchase has no renewal, so it gets its own sentence rather than the
         "renews automatically" one Play requires for subscriptions (#245). -->
    <string name="pw_terms_lifetime">%1$s, once. No subscription and nothing to cancel.</string>
    <string name="pw_plan_lifetime">Lifetime</string>
    <string name="pw_plan_lifetime_period">One payment, yours for good</string>
    <string name="pw_period_monthly">monthly</string>
    <string name="pw_period_annual">annually</string>

