    <!-- Auto-detect opt-in -->
    <string name="rf_autodetect_title">Auto-detect</string>
    <string name="rf_optin_title">Log a fill without touching the app</string>
    <string name="rf_optin_body">When you pay at a pump, Odo can read that one payment notification and draft the entry for you.</string>
    <string name="rf_optin_reads_amount">Reads only the amount and merchant name</string>
    <string name="rf_optin_reads_fuel_only">Only when the merchant is a fuel station</string>
    <string name="rf_optin_never_others">Never your other notifications</string>
    <string name="rf_optin_never_payment">Never sits inside your payment</string>
    <string name="rf_optin_on_device">Runs on your phone. Nothing about your payments leaves the device.</string>
    <string name="rf_optin_cta">Turn on auto-detect</string>
    <string name="rf_optin_continue">See what it needs</string>
    <string name="rf_setup_heading">Two permissions, one at a time</string>
    <string name="rf_autostart_heading">One setting Odo can’t ask for</string>
    <string name="rf_autostart_intro">The permissions are done. This last one is your phone’s own, and only you can turn it on.</string>
    <string name="rf_autostart_skip">Skip for now</string>
    <string name="rf_setup_intro">Both are Android switches. Odo asks for them separately because they do different things, and the second one is the one that matters.</string>
    <string name="rf_optin_cta_notify">Allow notifications</string>
    <string name="rf_optin_cta_notify_blocked">Open app settings</string>
    <string name="rf_optin_cta_access">Open notification access</string>

    <!-- Forewarning for the OEM permission screen. -->
    <string name="rf_warning_title">The next screen is your phone’s, and it looks alarming</string>
    <string name="rf_warning_body">Android has one switch for notification access, so the warning it shows lists everything any app could do with it — not what Odo does. Some phones put a red danger sign on it. It is the same switch either way.</string>
    <string name="rf_warning_sms">It may say “Read all SMS”. Odo does not ask for the SMS permission at all, so it cannot read a single message — check the app’s permissions yourself and you will not find it.</string>
    <string name="rf_warning_scope">What Odo reads is one line from one notification, and only when the sender is a payment app and the merchant is a fuel station.</string>
    <string name="rf_warning_how">On that screen: turn Odo on, tick the box at the bottom if there is one, then confirm.</string>

    <!-- The two-permission setup chain. -->
    <string name="rf_setup_label">What Odo needs</string>
    <string name="rf_setup_state_done">Done</string>
    <string name="rf_setup_state_pending">Not yet</string>
    <string name="rf_setup_notify_title">1. Let Odo notify you</string>
    <string name="rf_setup_notify_body">Odo hands you the fill as a notification you confirm in one tap. Without this a detected fill has nowhere to appear.</string>
    <string name="rf_setup_notify_blocked">Notifications are switched off for Odo. Turn them back on in app settings.</string>
    <string name="rf_setup_read_title">2. Let Odo read payment notifications</string>
    <string name="rf_setup_read_body">Step 1 only lets Odo show you notifications. Reading the one your payment app posts is a separate Android switch, and detection cannot work without it. The system will warn that Odo can read every notification — what it actually reads is the list above.</string>
    <string name="rf_optin_not_now">Not now</string>

