    <!-- ===================== Delete account ===================== -->
    <string name="pf_da_title">Delete my account &amp; data</string>

    <!-- The confirmation. Says what goes, and that none of it can come back — an owner
         reaching this screen is about to do the one thing the app cannot undo. -->
    <string name="pf_da_confirm_heading">This cannot be undone</string>
    <string name="pf_da_confirm_body">Your car, its full service history, every document you uploaded and your profile will be deleted from this phone and from our servers. Nothing is kept, and nothing can be restored.</string>
    <!-- Shown only when signed in. %1$s is the masked number, e.g. "•••• 10". -->
    <string name="pf_da_confirm_code_note">We\'ll text a code to %1$s first, to make sure it\'s you.</string>
    <string name="pf_da_confirm_local_note">This phone was never signed in, so there is nothing on our servers to delete.</string>
    <!-- %1$s is the phrase that has to be typed, held in code (DeleteAccountUiState) rather
         than here: the string the owner types and the string the app compares must be the
         same one, or a translation would lock out everyone who reads it. -->
    <string name="pf_da_confirm_phrase_label">Type “%1$s” to confirm</string>
    <string name="pf_da_confirm_action">Delete everything</string>
    <string name="pf_da_cancel">Cancel</string>

    <!-- The code step. -->
    <string name="pf_da_verify_heading">Enter the code</string>
    <!-- %1$s is the masked number. -->
    <string name="pf_da_verify_body">Sent to %1$s. Entering it deletes your account straight away.</string>
    <string name="pf_da_verify_action">Confirm deletion</string>
    <string name="pf_da_resend">Send it again</string>

    <string name="pf_da_working">Deleting…</string>

    <!-- The account is gone and this phone kept its copy. Neither success nor failure. -->
    <string name="pf_da_local_failed_heading">Your account is deleted</string>
    <string name="pf_da_local_failed_body">This phone still has a copy that we couldn\'t remove. Nothing is left on our servers. You can try again, or uninstall Odo to be sure.</string>
    <string name="pf_da_local_failed_action">Remove it from this phone</string>

    <!-- Errors. Each one says what state the account is actually in, because that is what
         decides what the owner does next. -->
    <string name="pf_da_error_code_wrong">That code isn\'t right. Check it and try again.</string>
    <string name="pf_da_error_code_expired">That code has expired. Ask for a new one.</string>
    <string name="pf_da_error_no_code">We couldn\'t send the code. Check your connection and try again.</string>
    <string name="pf_da_error_throttled">Too many codes requested. Wait a moment and try again.</string>
    <string name="pf_da_error_reverify">We need you to confirm your number again before deleting.</string>
    <string name="pf_da_error_local_survived">Your account is deleted, but this phone still has a copy.</string>
    <string name="pf_da_error_failed">We couldn\'t delete your account. Nothing has been removed — please try again.</string>
