    <string name="ao_handoff_preview_header">Location permission</string>

    <!-- Step one: fine location, the measurement itself. -->
    <string name="ao_permissions_location_title">Location, to measure the distance</string>
    <string name="ao_permissions_location_body">There is no way to know how far you drove without it. Odo reads your position while the car is moving and turns it into a single number: kilometres.</string>
    <string name="ao_permissions_location_label">HOW IT IS USED</string>
    <string name="ao_permissions_location_yes_distance">Distance and duration of a drive</string>
    <string name="ao_permissions_location_yes_window_stereo">Only between the stereo connecting and disconnecting</string>
    <string name="ao_permissions_location_yes_window_no_stereo">Only between a drive starting and ending</string>
    <string name="ao_permissions_location_no_route">The route is never saved</string>
    <string name="ao_permissions_location_no_share">Never shared, never sold, never sent off the phone</string>

    <!-- Step one, second half: the choice Android puts on its own screen. -->
    <string name="ao_location_handoff_screen">Location</string>
    <string name="ao_location_handoff_title">Choose “while using the app”</string>
    <string name="ao_location_handoff_body">That is all Odo needs to start. Android will offer “Only this time” too, but it forgets after one drive — you would be asked again tomorrow.</string>
    <string name="ao_location_handoff_instruction">Step 2 covers what happens when the app is closed.</string>
    <string name="ao_location_handoff_note">Pick the second one. “Ask every time” forgets after one drive.</string>
    <string name="ao_location_handoff_cta">Allow location</string>
    <string name="ao_location_option_always">Allow all the time</string>
    <string name="ao_location_option_while_using">Allow while using the app</string>
    <string name="ao_location_option_ask">Ask every time</string>
    <string name="ao_location_option_deny">Don’t allow</string>

    <!-- Step two: background location, the one that makes it automatic. -->
    <string name="ao_permissions_background_title">So it works with the app closed</string>
    <string name="ao_permissions_background_body">Nobody opens an app before starting the car. This switch is what makes it automatic — without it Odo only measures a drive that happens while the app is already open.</string>
    <string name="ao_permissions_background_body_history">Odo caught these drives because the app happened to be open. Nobody opens an app before starting the car — this switch is what makes it automatic.</string>
    <string name="ao_permissions_background_label">WHAT DOES NOT CHANGE</string>
    <string name="ao_permissions_background_no_idle_stereo">Still nothing when the stereo is disconnected</string>
    <string name="ao_permissions_background_no_idle_no_stereo">Still nothing unless you are driving your car</string>
    <string name="ao_permissions_background_no_route">The route is still discarded, still nothing off the phone</string>
    <string name="ao_permissions_background_revert">Revert to “while using” any time in settings</string>
    <string name="ao_permissions_background_skip">Keep it to while using</string>

    <!-- The owner’s own drives, when there are any to argue from. -->
    <string name="ao_drives_today">Today</string>
    <string name="ao_drives_caught">app was open</string>
    <string name="ao_drives_missed">missed</string>
    <string name="ao_drives_closed">app closed</string>

    <!-- Step two, second half: Android gives this its own screen. -->
    <string name="ao_background_handoff_screen">Location, all the time</string>
    <string name="ao_background_handoff_title">Android puts this on its own screen</string>
    <string name="ao_background_handoff_body">It will show a map of where Odo has read your location and ask you to pick “Allow all the time”. The map is the phone’s record, not something Odo kept.</string>
    <string name="ao_background_handoff_note">Android shows a map of recent location use above this list — that is the phone’s own record.</string>
    <string name="ao_background_handoff_cta">Open location settings</string>

    <!-- Step three: activity recognition, on the no-stereo path only. -->
    <string name="ao_permissions_activity_title">Notice when you are driving</string>
    <string name="ao_permissions_activity_body">Without a stereo to go by, Odo needs to tell a drive from a walk or a train ride. Android calls that activity recognition.</string>
    <string name="ao_permissions_activity_label">HOW IT IS USED</string>
    <string name="ao_permissions_activity_yes_vehicle">Whether you are in a vehicle, walking, or still</string>
    <string name="ao_permissions_activity_yes_window">Only to start and stop a drive</string>
    <string name="ao_permissions_activity_no_steps">Never your step count, never a fitness record</string>
    <string name="ao_permissions_activity_no_share">Nothing leaves your phone</string>
    <string name="ao_permissions_activity_cta">Allow activity access</string>

