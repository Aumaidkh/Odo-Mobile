    <!-- Education (M2) -->
    <string name="ao_flow_title">Auto Odometer</string>
    <string name="ao_cd_close">Close</string>
    <string name="ao_education_title">Your reading stays current on its own</string>
    <string name="ao_education_body_stereo">When your car’s stereo connects, Odo measures how far you drive and adds it to your odometer. You stop typing a number you can never quite remember.</string>
    <string name="ao_education_body_no_stereo">When Odo notices your phone moving like a car, it measures how far you drive and adds it to your odometer. You stop typing a number you can never quite remember.</string>
    <string name="ao_education_keeps_label">WHAT ODO KEEPS</string>
    <string name="ao_education_keeps_distance">How far you drove, and for how long</string>
    <string name="ao_education_keeps_no_route">Where you went — the route is discarded once the distance is measured</string>
    <string name="ao_education_keeps_no_idle_stereo">Anything at all when the stereo is not connected</string>
    <string name="ao_education_keeps_no_idle_no_stereo">Anything at all unless you are driving your car</string>
    <string name="ao_education_keeps_no_upload">Nothing leaves your phone</string>
    <string name="ao_education_step1_stereo">You start the car</string>
    <string name="ao_education_step1_no_stereo">You start driving — Odo notices the motion</string>
    <string name="ao_education_step2">Odo measures the distance</string>
    <string name="ao_education_step3">Your odometer ticks up when you park</string>
    <string name="ao_education_cta_stereo">Pair my car</string>
    <string name="ao_education_cta_no_stereo">Turn it on</string>
    <string name="ao_education_dismiss">Not now</string>

    <!-- Device picker (M3) -->
    <string name="ao_cd_back">Back</string>
    <string name="ao_picker_title">Which one is your car?</string>
    <string name="ao_picker_body">Pick the stereo that starts a trip when it connects.</string>
    <string name="ao_picker_section_connected">CONNECTED NOW</string>
    <string name="ao_picker_section_other">OTHER PAIRED DEVICES</string>
    <string name="ao_picker_category_car_audio">Car stereo</string>
    <string name="ao_picker_category_headset">Earbuds</string>
    <string name="ao_picker_category_wearable">Watch</string>
    <string name="ao_picker_category_other">Other device</string>
    <string name="ao_picker_not_connected">%1$s · not connected</string>
    <string name="ao_picker_hint">Don’t see it? Start your car so the stereo connects, then come back.</string>
    <string name="ao_picker_no_bluetooth">My car has no Bluetooth</string>
    <string name="ao_picker_cta">Use %1$s</string>
    <string name="ao_picker_permission_title">Odo needs Bluetooth</string>
    <string name="ao_picker_permission_rationale">Odo needs Bluetooth to see your paired devices, so it can tell which one is your car.</string>
    <string name="ao_picker_permission_blocked">Bluetooth access is off for Odo — open settings to pick your car.</string>
    <string name="ao_picker_permission_allow">Allow Bluetooth access</string>
    <string name="ao_picker_permission_dismiss">Not now</string>
    <string name="ao_picker_bt_off_title">Your Bluetooth is off</string>
    <string name="ao_picker_bt_off_body">Odo finds your car by watching for its stereo connecting over Bluetooth, so it needs the radio switched on to show your paired devices. It only ever reads devices you have already paired — it never searches for anything nearby, and none of it leaves your phone.</string>
    <string name="ao_picker_bt_off_action">Turn on Bluetooth</string>
    <string name="ao_picker_bt_sheet_title">Turn on Bluetooth?</string>
    <string name="ao_picker_bt_sheet_body">Your phone will ask you to confirm. Odo uses Bluetooth only to notice when your car’s stereo connects, which is what starts a trip. You can turn it back off any time.</string>
    <string name="ao_picker_bt_sheet_confirm">Turn it on</string>
    <string name="ao_picker_bt_sheet_dismiss">Not now</string>

    <!-- Permission setup (M4): shared chrome -->
